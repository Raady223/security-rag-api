# Copy this file to .env and fill in your key:  cp .env.example .env
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Models (checked against the Gemini docs, November 2026)
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# Postgres. Inside Docker Compose the host is "db" (the service name).
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag

# Relevance gate: if the best chunk is farther than this, answer "not found"
MAX_DISTANCE=0.45
